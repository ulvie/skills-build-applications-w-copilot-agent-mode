{
  "name": "octofit-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check-mongo": "npm run build && node dist/scripts/check-mongodb.js",
    "seed": "npm run check-mongo && npm run build && node dist/scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.1.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.1",
    "@types/express": "^4.17.17"
  }
}
